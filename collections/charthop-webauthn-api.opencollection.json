          "info": {
            "name": "Check for an existing physical key for this user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/webauthn/verify"
          },
          "docs": "Check for an existing physical key for this user"
        },
        {
          "info": {
            "name": "Delete registered credentials by the given credential ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/webauthn/:credentialId",
