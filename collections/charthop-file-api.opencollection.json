          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v1/org/:orgId/file/:fileId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "fileId",
                "value": "",
                "type": "path",
                "description": "File id"
              }
            ]
          },
