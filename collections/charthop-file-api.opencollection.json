          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/org/:orgId/file/:fileId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "fileId",
                "value": "",
                "type": "path",
                "description": "File id"
              }
            ]
          },
          "docs": "Delete a file"
        },
        {
          "info": {
            "name": "Download a file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/org/:orgId/file/:fileId/download",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "fileId",
                "value": "",
                "type": "path",
                "description": "File id"
              }
            ]
          },
          "docs": "Download a file"
        }
      ]
    }
  ],
  "bundled": true
}