          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/org/:orgId/file/:fileId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "fileId",
                "value": "",
                "type": "path",
                "description": "File id"
              }
            ]
          },
          "docs": "Returns metadata about a file"
        },
        {
          "info": {
            "name": "Update a file's metadata",
            "type": "http"
