          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/org/:orgId/budget-pool",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "compReviewId",
