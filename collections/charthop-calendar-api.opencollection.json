            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "calendarIds",
                "value": "",
                "type": "query",
                "description": "Calendar IDs to filter by, comma-separated"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return"
              },
              {
                "name": "returnAccess",
                "value": "",
                "type": "query",
                "description": "Return access information -- pass a list of actions to check, for example: create,update,delete"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Optional status to filter by"
              }
            ]
          },
          "docs": "Return calendars visible to the current user"
        },
        {
          "info": {
            "name": "Create a new calendar",
