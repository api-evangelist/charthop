        {
          "info": {
            "name": "Returns calendar events visible to the current user with exclusive end dates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/org/:orgId/calendar-event",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Date to get events from, inclusive"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "Date to get events until, inclusive"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Optional CQL filter to apply to employee events"
              },
              {
                "name": "calendarIds",
                "value": "",
                "type": "query",
                "description": "Calendar IDs to filter by, comma-separated"
              }
            ]
          },
          "docs": "Returns calendar events visible to the current user with exclusive end dates"
