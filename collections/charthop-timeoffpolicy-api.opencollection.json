                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Org identifier (either id or slug)"
              },
              {
                "name": "personId",
                "value": "",
                "type": "path",
                "description": "Person ID"
              },
              {
                "name": "date",
                "value": "",
                "type": "query",
                "description": "Date"
              },
              {
                "name": "format",
                "value": "",
                "type": "query",
                "description": "Data format to use; default is json, can also use json-extended or json-readable"
              }
            ]
          },
          "docs": "Return time off balances per policy for a given person"
        },
        {
          "info": {
            "name": "Adjust time off balances for a group of people on a given policy and effective date",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/org/:orgId/timeoff/policy/balances/:policyId",
