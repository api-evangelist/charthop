              {
                "name": "policyId",
                "value": "",
                "type": "path",
                "description": "Policy id associated with balances"
              },
              {
                "name": "date",
                "value": "",
                "type": "query",
                "description": "Effective Date"
              },
              {
                "name": "enterMatching",
                "value": "",
                "type": "query",
                "description": "Add adjustment even if it matches current balance"
              }
            ]
          },
          "docs": "Adjust time off balances for a group of people on a given policy and effective date"
